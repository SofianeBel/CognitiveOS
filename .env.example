# CognitiveOS Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM PROVIDER
# =============================================================================

# Provider: "openai" or "ollama"
LLM_PROVIDER=openai

# OpenAI Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-api-key-here

# Ollama Configuration (required if LLM_PROVIDER=ollama)
# Install Ollama: https://ollama.com/download
# Then run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =============================================================================
# STORAGE
# =============================================================================

# Storage backend: "json" or "sqlite"
STORAGE_BACKEND=json

# JSON storage path (used when STORAGE_BACKEND=json)
MEMORY_FILE=data/memory.json

# SQLite storage path (used when STORAGE_BACKEND=sqlite)
DATABASE_PATH=data/memory.db

# =============================================================================
# RETRIEVAL
# =============================================================================

# Number of context items to retrieve
RETRIEVAL_TOP_K=10

# Minimum similarity for retrieval (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.7

# Similarity threshold for duplicate detection (0.0 to 1.0)
DUPLICATE_THRESHOLD=0.85

# =============================================================================
# CONSOLIDATION (Memory Optimization)
# =============================================================================

# Enable memory consolidation features
CONSOLIDATION_ENABLED=true

# Similarity threshold for merging duplicates (0.0 to 1.0)
# Higher = more strict, fewer merges
DUPLICATE_MERGE_THRESHOLD=0.9

# Days of inactivity before considering for pruning
PRUNE_INACTIVE_DAYS=30

# Maximum importance score for nodes to be pruned (0.0 to 1.0)
# Only nodes with importance below this AND inactive will be pruned
PRUNE_IMPORTANCE_THRESHOLD=0.3

# =============================================================================
# APPLICATION
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
